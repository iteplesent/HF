def kinetic_matrix(molecule):
    T=np.zeros((num_basis_funcs, num_basis_funcs))
    for i in range(num_basis_funcs):
        for j in range(num_basis_funcs):
            nprimitives_i = len(molecule[i])
            nprimitives_j = len(molecule[j])
            for k in range(nprimitives_i):
                for l in range(nprimitives_j):
                    a, b = exponents[k], exponents[l]
                    d_k, d_l = coeffs[k], coeffs[l]
                    r=molecule[i][k].coordinates - molecule[j][l].coordinates
                    r2=np.dot(r,r)
                    T[i,j]+=d_k*d_l*a*b/(a+b)*(3-2*a*b/(a+b)*r2)*np.exp(-r2*a*b/(a+b))*(np.pi/(a+b))**1.5

    return T

def F0(t): #boys function when n=0
    if t ==0:  
        return 1.0
    else:
        return 0.5 * np.sqrt(np.pi / t) * special.erf(np.sqrt(t))

def nuclear(molecule,Z):
    V=np.zeros((num_basis_funcs, num_basis_funcs))
    for z in Z: 
        for i in range(num_basis_funcs):
            for j in range(num_basis_funcs):
                nprimitives_i = len(molecule[i])
                nprimitives_j = len(molecule[j])
                for k in range(nprimitives_i):
                    for l in range(nprimitives_j):
                        a, b = exponents[k], exponents[l]
                        d_k, d_l = coeffs[k], coeffs[l]

                        p   = a+b
                        P   = molecule[i][k].alpha*molecule[i][k].coordinates +  molecule[j][l].alpha*molecule[j][l].coordinates
                        R_p  = P/p

                        R_ab=molecule[i][k].coordinates - molecule[j][l].coordinates
                        R_ab2=np.dot(R_ab,R_ab)
                        R_pc=R_p - z.coordinates
                        R_pc2=np.dot(R_pc,R_pc)
                        V[i,j] += -2*np.pi*d_k*d_l/p*z.Z*np.exp(-a*b/(a+b)*R_ab2)*F0(p*R_pc2)

    return V


def electron_electron_repulsion(molecule):
    eri=np.zeros((num_basis_funcs, num_basis_funcs, num_basis_funcs, num_basis_funcs))
    for i in range(num_basis_funcs):
        for j in range(num_basis_funcs):
            for k in range(num_basis_funcs):
                for l in range(num_basis_funcs):
                    nprimitives_i = len(molecule[i])
                    nprimitives_j = len(molecule[j])
                    nprimitives_k = len(molecule[k])
                    nprimitives_l = len(molecule[l])
                    for ii in range(nprimitives_i):
                        for jj in range(nprimitives_j):
                            for kk in range(nprimitives_k):
                                for ll in range(nprimitives_l):
                                    a,b,c,d=exponents[ii], exponents[jj],exponents[kk], exponents[ll]
                                    d_1, d_2, d_3, d_4 = coeffs[ii], coeffs[jj], coeffs[kk], coeffs[ll]
                                    R_ab=molecule[i][ii].coordinates - molecule[j][jj].coordinates
                                    R_ab2=np.dot(R_ab,R_ab)
                                    R_cd=molecule[k][kk].coordinates - molecule[l][ll].coordinates
                                    R_cd2=np.dot(R_cd,R_cd)
                                    R_p=(molecule[i][ii].alpha*molecule[i][ii].coordinates +  b*molecule[j][jj].coordinates)/(a+b)
                                    R_q=(c*molecule[k][kk].coordinates +  d*molecule[l][ll].coordinates)/(c+d)
                                    R_pq=R_p-R_q
                                    R_pq2=np.dot(R_pq,R_pq)
                                    term1=2*np.pi**2.5/((a+b)*(c+d)*np.sqrt(a+b+c+d))
                                    term2=np.exp(-a*b/(a+b)*R_ab2-c*d/(c+d)*R_cd2)
                                    term3=F0((a+b)*(c+d)/(a+b+c+d)*R_pq2)
                                    eri[i,j,k,l]+=d_1*d_2*d_3*d_4*term1*term2*term3                            
    return eri

def nuclear_repulsion(Z):
    E_n=0
    l=len(Z)
    for i in range(l):
        for j in range(i+1,l):
            r=Z[i].coordinates-Z[j].coordinates
            r2=np.sqrt(np.dot(r,r))
            E_n+=Z[i].Z*Z[j].Z/r2
    return E_n



